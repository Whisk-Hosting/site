{
  "name": "whisk-site",
  "version": "1.0.0",
  "private": true,
  "description": "A business's website on Whisk: pages drawn by a Go server from the editor's content, in one app.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/site.mjs build",
    "start": "go run .",
    "dev": "node scripts/site.mjs dev",
    "migrate": "node migrate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "go test ./... && tsx --test cms/test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
