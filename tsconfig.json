{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["server/**/*", "test/**/*", "server.mjs", "migrate.mjs", "scripts/**/*"],
  "exclude": ["node_modules", "storefront", "cms"]
}
